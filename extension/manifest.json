{
  "manifest_version": 3,
  "name": "FruchtDrama",
  "version": "0.1.96.33",
  "key": "",
  "description": "Ouvre une fenêtre FruchtDrama où tout se passe : studio, IA, Flow et comptes. Relie vos sessions de création au studio local.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8840/*",
    "https://www.tiktok.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.googlevideo.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://lmarena.ai/*",
    "https://*.lmarena.ai/*",
    "https://arena.ai/*",
    "https://*.arena.ai/*",
    "https://vidogrid.ai/*",
    "https://*.vidogrid.ai/*"
  ],
  "action": {
    "default_title": "Ouvrir la fenêtre FruchtDrama",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8840/*"
      ],
      "js": [
        "studio-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
